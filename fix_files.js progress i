    const regex = /<input type="checkbox"[^>]*checked={row\.checked}[^>]*\/>\s*<\/td>([\s\S]*?)<td[^>]*>{row\.orderNumber}<\/td>/g;
    content = content.replace(regex, (match, p1) => {
       return `<input type="checkbox" checked={row.checked} onChange={() => toggleCheck(row.id)} className="w-4 h-4 text-amber-600 rounded cursor-pointer" />\n                      </td>\n                      <td className="px-5 py-3 whitespace-nowrap">{row.orderNumber}</td>`;
    });
